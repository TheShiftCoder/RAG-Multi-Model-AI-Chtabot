# ==========================================
# Secure Multimodal AI Companion Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Secure Multimodal AI Companion"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (MySQL with PyMySQL driver)
# Note: In development or test environments without MySQL, the application
# automatically and gracefully falls back to local SQLite at ./multimodal_ai.db
DATABASE_URL="mysql+pymysql://root:your_mysql_password@localhost:3306/multimodal_ai"

# AI Model Provider Selection
# Options for LLM_PROVIDER: "fallback" (local offline), "openai", "gemini"
LLM_PROVIDER="fallback"

# Options for EMBEDDING_PROVIDER: "local" (deterministic normalized FAISS), "openai"
EMBEDDING_PROVIDER="local"

# Options for VISION_PROVIDER: "fallback" (local PIL analysis), "openai"
VISION_PROVIDER="fallback"

# Options for STT_PROVIDER: "fallback" (local audio inspection), "openai"
STT_PROVIDER="fallback"

# Options for TTS_PROVIDER: "gtts" (Google TTS offline/free), "openai", "fallback"
TTS_PROVIDER="gtts"

# Options for IMAGE_GEN_PROVIDER: "fallback" (local graphical generator), "openai"
IMAGE_GEN_PROVIDER="fallback"

# External API Keys (Optional - required only if LLM_PROVIDER="openai" or "gemini")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# RAG & Retrieval Thresholds
SIMILARITY_THRESHOLD=0.35
MAX_RETRIEVAL_CHUNKS=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Security Limits
MAX_UPLOAD_SIZE_BYTES=20971520

# Streamlit Backend Connection
BACKEND_URL="http://127.0.0.1:8000/api"

